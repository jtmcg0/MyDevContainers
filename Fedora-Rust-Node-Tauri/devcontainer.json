{
  "name": "Fedora + Rust + Node.js + Tauri",
 
  // Using 41 because at present 42 image has error with awk
  "image": "fedora:41",
 
  // Set container workspace directory
  "workspaceFolder": "/workspace",
 
  // Bind local workspace to container workspace
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,Z",
  
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "ms-vscode.vscode-typescript-next"
      ]
    }
  },
  "postCreateCommand": "bash /workspace/.devcontainer/devcontainer-setup.sh",
  "remoteUser": "root"
}
