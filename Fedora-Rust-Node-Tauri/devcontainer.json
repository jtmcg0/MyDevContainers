{
  "name": "Fedora + Rust + Node.js + Tauri",
  "image": "fedora:latest",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "ms-vscode.vscode-typescript-next"
      ]
    }
  },
  "postCreateCommand": "bash /usr/local/bin/devcontainer-setup.sh",
  "mounts": [
    "source=${localEnv:HOME}/.cargo,target=/root/.cargo,type=bind",
    "source=${localEnv:HOME}/.rustup,target=/root/.rustup,type=bind"
  ],
  "remoteUser": "root"
}
